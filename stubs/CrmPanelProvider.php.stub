<?php

namespace App\Providers\Filament;

use Filament\Http\Middleware\Authenticate;
use Filament\Http\Middleware\AuthenticateSession;
use Filament\Http\Middleware\DisableBladeIconComponents;
use Filament\Http\Middleware\DispatchServingFilamentEvent;
use Filament\Pages;
use Filament\Panel;
use Filament\PanelProvider;
use Filament\Support\Colors\Color;
use Illuminate\Cookie\Middleware\AddQueuedCookiesToResponse;
use Illuminate\Cookie\Middleware\EncryptCookies;
use Illuminate\Foundation\Http\Middleware\VerifyCsrfToken;
use Illuminate\Routing\Middleware\SubstituteBindings;
use Illuminate\Session\Middleware\StartSession;
use Illuminate\View\Middleware\ShareErrorsFromSession;
use VentureDrake\LaravelCrmFilament\Auth\Login;
use VentureDrake\LaravelCrmFilament\Auth\Profile;
use VentureDrake\LaravelCrmFilament\LaravelCrmPlugin;
use VentureDrake\LaravelCrmFilament\Support\LogoUrl;

class CrmPanelProvider extends PanelProvider
{
    public function panel(Panel $panel): Panel
    {
        $settings = app('laravel-crm.settings');
        $brandName = $settings->get('organization_name') ?: config('app.name');
        $brandLogo = $settings->get('logo_file');
        $primary = $settings->get('primary_color') ?: '#05b3a9';

        return $panel
            ->id('crm')
            ->path('crm')
            ->login(Login::class)
            ->profile(Profile::class)
            ->brandName($brandName)
            // `logo_file` is a path on the `public` disk (that's what the CRM's
            // General settings uploader writes), so resolve it through the disk.
            ->brandLogo(LogoUrl::resolve($brandLogo))
            ->colors([
                'primary' => Color::hex($primary),
            ])
            ->pages([
                Pages\Dashboard::class,
            ])
            ->middleware([
                EncryptCookies::class,
                AddQueuedCookiesToResponse::class,
                StartSession::class,
                AuthenticateSession::class,
                ShareErrorsFromSession::class,
                VerifyCsrfToken::class,
                SubstituteBindings::class,
                DisableBladeIconComponents::class,
                DispatchServingFilamentEvent::class,
            ])
            ->authMiddleware([
                Authenticate::class,
            ])
            ->plugin(
                LaravelCrmPlugin::make()
                // ->modules(['leads' => true, 'deals' => true, ...])
                // ->withChat()
                // ->withEmailMarketing()
                // ->withSmsMarketing()
                // ->withCustomers()
                // ->withXero()
                // ->navigationGroup('CRM')
            );
    }
}
